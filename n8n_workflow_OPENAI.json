{
    "name": "Lume - Voice (Groq + OpenRouter)",
    "nodes": [
        {
            "parameters": {
                "httpMethod": "POST",
                "path": "lume-voice-openai",
                "responseMode": "responseNode",
                "options": {
                    "rawBody": false
                }
            },
            "id": "webhook",
            "name": "Webhook",
            "type": "n8n-nodes-base.webhook",
            "typeVersion": 2,
            "position": [
                240,
                300
            ],
            "webhookId": "lume-voice-openai"
        },
        {
            "parameters": {
                "method": "POST",
                "url": "https://api.groq.com/openai/v1/audio/transcriptions",
                "sendHeaders": true,
                "headerParameters": {
                    "parameters": [
                        {
                            "name": "Authorization",
                            "value": "Bearer YOUR_GROQ_API_KEY"
                        }
                    ]
                },
                "sendBody": true,
                "contentType": "multipart-form-data",
                "bodyParameters": {
                    "parameters": [
                        {
                            "parameterType": "formBinaryData",
                            "name": "file",
                            "inputDataFieldName": "audio"
                        },
                        {
                            "parameterType": "formData",
                            "name": "model",
                            "value": "whisper-large-v3"
                        },
                        {
                            "parameterType": "formData",
                            "name": "language",
                            "value": "pt"
                        }
                    ]
                },
                "options": {}
            },
            "id": "whisper",
            "name": "Groq Whisper",
            "type": "n8n-nodes-base.httpRequest",
            "typeVersion": 4.2,
            "position": [
                440,
                300
            ]
        },
        {
            "parameters": {
                "method": "POST",
                "url": "https://openrouter.ai/api/v1/chat/completions",
                "sendHeaders": true,
                "headerParameters": {
                    "parameters": [
                        {
                            "name": "Authorization",
                            "value": "Bearer YOUR_OPENROUTER_API_KEY"
                        },
                        {
                            "name": "Content-Type",
                            "value": "application/json"
                        },
                        {
                            "name": "HTTP-Referer",
                            "value": "http://localhost:8000"
                        },
                        {
                            "name": "X-Title",
                            "value": "Lume Finance"
                        }
                    ]
                },
                "sendBody": true,
                "specifyBody": "json",
                "jsonBody": "={\n  \"model\": \"meta-llama/llama-3.3-70b-instruct:free\",\n  \"messages\": [\n    {\n      \"role\": \"system\",\n      \"content\": \"Você é um assistente financeiro especializado em extrair transações de áudios em português brasileiro.\\n\\nREGRAS:\\n1. Se houver MÚLTIPLAS transações no áudio, retorne um ARRAY de objetos\\n2. Se houver apenas UMA transação, retorne um OBJETO único (não array)\\n3. Identifique corretamente se é DESPESA (expense) ou RECEITA (income)\\n4. Palavras como 'gastei', 'paguei', 'comprei' = expense\\n5. Palavras como 'recebi', 'ganhei', 'entrou' = income\\n6. Extraia o valor em reais (número decimal, ex: 8.99)\\n7. Categorias válidas: Alimentação, Mercado, Transporte, Lazer, Roupas, Jogos, Saúde, Esportes, Investimento, Educação, Moradia, Contas, Assinaturas, Beleza, Pets, Viagem, Presentes, Salário, Extra, Outros\\n8. Crie uma descrição curta e clara\\n\\nFORMATO DE RESPOSTA:\\n- Uma transação: {\\\"description\\\":\\\"...\\\",\\\"amount\\\":0.00,\\\"category\\\":\\\"...\\\",\\\"type\\\":\\\"expense\\\"}\\n- Múltiplas: [{\\\"description\\\":\\\"...\\\",\\\"amount\\\":0.00,\\\"category\\\":\\\"...\\\",\\\"type\\\":\\\"expense\\\"}, ...]\\n\\nRetorne APENAS o JSON, sem texto adicional.\"\n    },\n    {\n      \"role\": \"user\",\n      \"content\": \"{{ $json.text }}\"\n    }\n  ],\n  \"temperature\": 0.2\n}"
            },
            "id": "gpt",
            "name": "LLaMA Analysis",
            "type": "n8n-nodes-base.httpRequest",
            "typeVersion": 4.2,
            "position": [
                640,
                300
            ]
        },
        {
            "parameters": {
                "jsCode": "const response = items[0].json.choices[0].message.content;\nlet data = JSON.parse(response.replace(/```json\\n?|```/g, '').trim());\nconst userId = $('Webhook').first().json.body.user_id;\nconst transcription = $('Groq Whisper').first().json.text;\nconst today = new Date().toISOString().split('T')[0];\n\n// Normalize to array\nif (!Array.isArray(data)) {\n  data = [data];\n}\n\n// Return array of transactions\nconst transactions = data.map(item => ({\n  user_id: userId,\n  transcription: transcription,\n  description: item.description,\n  amount: parseFloat(item.amount) || 0,\n  category: item.category || 'Outros',\n  type: item.type || 'expense',\n  transaction_date: today\n}));\n\nreturn {\n  json: {\n    status: 'success',\n    transactions: transactions\n  }\n};"
            },
            "id": "parse",
            "name": "Parse JSON",
            "type": "n8n-nodes-base.code",
            "typeVersion": 2,
            "position": [
                840,
                300
            ]
        },
        {
            "parameters": {
                "respondWith": "json",
                "responseBody": "={{ $json }}"
            },
            "id": "response",
            "name": "Response",
            "type": "n8n-nodes-base.respondToWebhook",
            "typeVersion": 1.1,
            "position": [
                1040,
                300
            ]
        }
    ],
    "connections": {
        "Webhook": {
            "main": [
                [
                    {
                        "node": "Groq Whisper",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "Groq Whisper": {
            "main": [
                [
                    {
                        "node": "LLaMA Analysis",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "LLaMA Analysis": {
            "main": [
                [
                    {
                        "node": "Parse JSON",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "Parse JSON": {
            "main": [
                [
                    {
                        "node": "Response",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        }
    }
}
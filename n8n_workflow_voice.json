{
  "name": "Lume - Voice Expense Processor",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "lume-voice",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "webhook-1",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "position": [250, 300],
      "webhookId": "lume-voice-webhook"
    },
    {
      "parameters": {
        "url": "https://api.groq.com/openai/v1/audio/transcriptions",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "groqApi",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $credentials.apiKey }}"
            }
          ]
        },
        "sendBody": true,
        "contentType": "multipart-form-data",
        "bodyParameters": {
          "parameters": [
            {
              "name": "file",
              "value": "={{ $binary.audio }}"
            },
            {
              "name": "model",
              "value": "whisper-large-v3"
            },
            {
              "name": "language",
              "value": "pt"
            }
          ]
        },
        "options": {}
      },
      "id": "groq-whisper",
      "name": "Groq Whisper (Transcrição)",
      "type": "n8n-nodes-base.httpRequest",
      "position": [450, 300]
    },
    {
      "parameters": {
        "url": "https://api.groq.com/openai/v1/chat/completions",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "groqApi",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $credentials.apiKey }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "model",
              "value": "llama-3.1-70b-versatile"
            },
            {
              "name": "messages",
              "value": "=[{\"role\":\"system\",\"content\":\"Você é um assistente financeiro. Analise a frase e extraia: descrição, valor (em reais), categoria (Alimentação, Transporte, Lazer, Contas, Salário, Extra, Outros), tipo (income ou expense). Retorne APENAS um JSON válido sem explicações: {\\\"description\\\":\\\"...\\\",\\\"amount\\\":0.00,\\\"category\\\":\\\"...\\\",\\\"type\\\":\\\"expense\\\"}\"},{\"role\":\"user\",\"content\":\"{{ $json.text }}\"}]"
            },
            {
              "name": "temperature",
              "value": "0.3"
            }
          ]
        },
        "options": {}
      },
      "id": "groq-llama",
      "name": "Groq LLaMA (Análise)",
      "type": "n8n-nodes-base.httpRequest",
      "position": [650, 300]
    },
    {
      "parameters": {
        "jsCode": "const response = $input.item.json.choices[0].message.content;\nconst data = JSON.parse(response.replace(/```json\\n?|```/g, '').trim());\n\nreturn {\n  json: {\n    user_id: $('Webhook').item.json.body.user_id,\n    description: data.description,\n    amount: parseFloat(data.amount),\n    category: data.category,\n    type: data.type,\n    transaction_date: new Date().toISOString().split('T')[0]\n  }\n};"
      },
      "id": "code-parser",
      "name": "Parse JSON",
      "type": "n8n-nodes-base.code",
      "position": [850, 300]
    },
    {
      "parameters": {
        "url": "=http://localhost:8000/process_voice.php",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "user_id",
              "value": "={{ $json.user_id }}"
            },
            {
              "name": "description",
              "value": "={{ $json.description }}"
            },
            {
              "name": "amount",
              "value": "={{ $json.amount }}"
            },
            {
              "name": "category",
              "value": "={{ $json.category }}"
            },
            {
              "name": "type",
              "value": "={{ $json.type }}"
            },
            {
              "name": "transaction_date",
              "value": "={{ $json.transaction_date }}"
            }
          ]
        },
        "options": {}
      },
      "id": "insert-db",
      "name": "Insert to Database",
      "type": "n8n-nodes-base.httpRequest",
      "position": [1050, 300]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ $json }}"
      },
      "id": "response",
      "name": "Response",
      "type": "n8n-nodes-base.respondToWebhook",
      "position": [1250, 300]
    }
  ],
  "connections": {
    "Webhook": {
      "main": [
        [
          {
            "node": "Groq Whisper (Transcrição)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Groq Whisper (Transcrição)": {
      "main": [
        [
          {
            "node": "Groq LLaMA (Análise)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Groq LLaMA (Análise)": {
      "main": [
        [
          {
            "node": "Parse JSON",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Parse JSON": {
      "main": [
        [
          {
            "node": "Insert to Database",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Insert to Database": {
      "main": [
        [
          {
            "node": "Response",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "pinData": {}
}
